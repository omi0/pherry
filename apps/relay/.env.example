# Relay configuration — every var read by src/main.ts.
#
# No dotenv dependency: load with `node --env-file=.env dist/main.js` (or an inline
# `KEY=val` prefix). Copy to `.env` to run a local cell on the host.

# This cell's stable id, bound into every host-registration challenge.
CELL_ID=cell-local

# The interface + raw-TCP port to accept host/controller connections on.
# LISTEN_PORT is NOT HTTP — any fronting proxy must be TCP passthrough (E2EE content).
LISTEN_HOST=0.0.0.0
LISTEN_PORT=9443

# The control plane's base URL, for the internal authorizer API. Must be an absolute
# http(s) URL. In production (NODE_ENV=production — the Docker image sets it) this MUST be
# https unless the host is loopback (127.0.0.1/localhost/::1): the shared secret below rides
# every call, so the relay refuses to boot if it would travel as cleartext to a public host.
# :3001 is the control plane's PRIVATE internal listener (its INTERNAL_LISTEN_PORT — H7);
# the public :3000 app no longer serves /internal/relay/*.
CONTROL_PLANE_URL=http://127.0.0.1:3001

# Shared secret guarding the internal API. MUST match the control plane's INTERNAL_API_KEY.
INTERNAL_API_KEY=dev-internal-key
