# Relay configuration — every var read by src/main.ts.
#
# No dotenv dependency: load with `node --env-file=.env dist/main.js` (or an inline
# `KEY=val` prefix). Copy to `.env` to run a local cell on the host.

# This cell's stable id, bound into every host-registration challenge.
CELL_ID=cell-local

# The interface + raw-TCP port to accept host/controller connections on.
# LISTEN_PORT is NOT HTTP — any fronting proxy must be TCP passthrough (E2EE content).
LISTEN_HOST=0.0.0.0
LISTEN_PORT=9443

# The control plane's base URL, for the internal authorizer API.
CONTROL_PLANE_URL=http://127.0.0.1:3000

# Shared secret guarding the internal API. MUST match the control plane's INTERNAL_API_KEY.
INTERNAL_API_KEY=dev-internal-key
