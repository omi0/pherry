{
  "name": "@pherry/control-plane",
  "version": "0.1.0",
  "private": true,
  "description": "The Pherry control plane — the stateless router: auth, tenancy, pairing, and relay-ticket coordination. Proprietary.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-main.ts"
  },
  "dependencies": {
    "@pherry/channel": "workspace:*",
    "@pherry/protocol": "workspace:*",
    "@pherry/relay-core": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.14",
    "@pherry/host": "workspace:*",
    "@pherry/sdk": "workspace:*",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
