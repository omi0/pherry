# Control-plane configuration — every var read by src/config.ts, plus PORT/HOST.
#
# There is NO dotenv dependency: the app reads process.env directly. Load this file
# with Node's native flag, e.g.  `node --env-file=.env dist/main.js`  (or, for the
# host migrate script, `node --env-file=.env` / an inline `KEY=val` prefix). Copy to
# `.env` and fill in the Clerk values when you want real human auth.
#
# The active values below point at the dev backing services from docker-compose.yml.

# --- Backing services (required to boot; see docker-compose.yml) ---
DATABASE_URL=postgres://pherry:pherry@localhost:5334/pherry
REDIS_URL=redis://localhost:6379

# --- The relay seam (required for the relay to talk to this API) ---
# Shared secret guarding the internal relay-validate route. MUST equal the relay's.
# REQUIRED in production (NODE_ENV=production) and must be >=32 chars — the boot refuses a
# missing or short key there. Short/absent is fine for local dev.
INTERNAL_API_KEY=dev-internal-key
# Optional private internal listener. When INTERNAL_LISTEN_PORT is set, the /internal/relay/*
# routes move to a SEPARATE listener bound to INTERNAL_LISTEN_HOST (default 127.0.0.1) and are
# OMITTED from the public app — keeping the relay<->control-plane seam off the public edge.
# Unset (the default) keeps them on the public app. See docs/deploying.md § Isolating the
# internal API. Point the relay's CONTROL_PLANE_URL at the private address when you set this.
#INTERNAL_LISTEN_PORT=3001
#INTERNAL_LISTEN_HOST=127.0.0.1

# --- Well-known URLs ---
# The relay director endpoint embedded verbatim into pairing QRs + relay tickets.
# Raw TCP — the host/controller dial it directly (locally the relay on 9443).
DIRECTOR_URL=tcp://127.0.0.1:9443
# This API's own public base URL.
API_PUBLIC_URL=http://127.0.0.1:3000
# The dashboard's public base URL. When set, CORS is scoped to exactly this origin
# and GET /cli/auth/:id 302s to the dashboard's approve page (the `dock` browser visit).
DASHBOARD_URL=http://localhost:5173

# --- Listen address (read by main.ts, not config.ts) ---
PORT=3000
HOST=0.0.0.0

# --- Human identity (Clerk). All optional; blank DEGRADES CLOSED (no human can
#     authenticate, pair redemption cannot mint a sign-in token, webhooks reject).
#     See docs/running-locally.md for wiring a free Clerk dev instance. ---
# The IdP token issuer, e.g. https://your-app.clerk.accounts.dev
#CLERK_ISSUER=
# JWKS endpoint. Leave unset — it auto-derives to ${CLERK_ISSUER}/.well-known/jwks.json.
#CLERK_JWKS_URL=
# Secret API key (server → Clerk) used to mint one-time sign-in tokens.
#CLERK_SECRET_KEY=
# Webhook signing secret (whsec_…) for the user/org sync webhook.
#CLERK_WEBHOOK_SECRET=

# --- Dev sign-in (dev/self-host only) ---
# A static human bearer token the DevIdentityProvider accepts — the dashboard's
# dev-token paste mode (docs/running-locally.md §5). Remove for production / when
# using Clerk: the server refuses to boot with both this and CLERK_ISSUER set.
DEV_HUMAN_TOKEN=dev-token-alice

# --- APNs (the push/ring channels; optional — blank keeps the honest logging stubs) ---
# Token-based (.p8) auth. Provide ALL FOUR creds to activate real push + ring delivery;
# an incomplete set DEGRADES to the P3a stubs (nothing is sent, one honest log line per
# raise). Tokens are treated as credentials — never logged, never echoed.
# The Apple developer team id (the provider JWT `iss`).
#APNS_TEAM_ID=
# The .p8 auth key id (the provider JWT header `kid`).
#APNS_KEY_ID=
# The .p8 private-key PEM *contents* (the key text, not a path). Multiline is fine in a
# secret store; in this file keep the BEGIN/END PRIVATE KEY block on its own lines.
#APNS_PRIVATE_KEY=
# The app bundle id — the apns-topic (voip pushes use ${APNS_BUNDLE_ID}.voip).
#APNS_BUNDLE_ID=
# Which APNs host to dial: sandbox (default) or production.
#APNS_ENVIRONMENT=sandbox

# --- TTLs (milliseconds). Shown as their defaults; uncomment to override. ---
# Pair-token lifetime (QR validity).
#PAIR_TOKEN_TTL_MS=600000
# Relay-ticket lifetime (one-time, GETDEL-consumed).
#RELAY_TICKET_TTL_MS=60000
# CLI-auth request lifetime (the `dock` login handshake).
#CLI_AUTH_REQUEST_TTL_MS=600000
# Minted ct_ human-token lifetime.
#CLI_TOKEN_TTL_MS=3600000

# --- Abuse-control knobs (per-minute counts). Shown as their defaults. ---
# Max POST /v1/pair/redeem attempts per minute per client IP.
#RATE_LIMIT_PAIR_REDEEM_PER_MIN=10
# Max POST /v1/relay/tickets mints per minute per principal.
#RATE_LIMIT_TICKETS_PER_MIN=30
# Max POST /v1/cli/auth/{start,exchange} attempts per minute per client IP.
#RATE_LIMIT_CLI_AUTH_PER_MIN=10
