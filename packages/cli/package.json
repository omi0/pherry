{
  "name": "@pherry/cli",
  "version": "0.1.0",
  "description": "The Pherry CLI — pherry.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pherry": "./dist/bin/pherry.js"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@pherry/channel": "workspace:*",
    "@pherry/host": "workspace:*",
    "@pherry/protocol": "workspace:*",
    "@pherry/relay-core": "workspace:*",
    "@pherry/sdk": "workspace:*",
    "@pherry/transport-node": "workspace:*",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
